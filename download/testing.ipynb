    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"from pathlib import Path\\n\",\n",
    "    \"\\n\",\n",
    "    \"def _extract_recids(payload):\\n\",\n",
    "    \"    recids = set()\\n\",\n",
    "    \"    if isinstance(payload, dict):\\n\",\n",
    "    \"        for key in ('recid', 'id'):\\n\",\n",
    "    \"            if key in payload:\\n\",\n",
    "    \"                try:\\n\",\n",
    "    \"                    recids.add(int(payload[key]))\\n\",\n",
    "    \"                except (TypeError, ValueError):\\n\",\n",
    "    \"                    pass\\n\",\n",
    "    \"        for key in ('hits', 'records', 'datasets', 'results'):\\n\",\n",
    "    \"            if isinstance(payload.get(key), list):\\n\",\n",
    "    \"                for item in payload[key]:\\n\",\n",
    "    \"                    recids |= _extract_recids(item)\\n\",\n",
    "    \"    elif isinstance(payload, list):\\n\",\n",
    "    \"        for item in payload:\\n\",\n",
    "    \"            recids |= _extract_recids(item)\\n\",\n",
    "    \"    elif isinstance(payload, (int, str)):\\n\",\n",
    "    \"        try:\\n\",\n",
    "    \"            recids.add(int(payload))\\n\",\n",
    "    \"        except ValueError:\\n\",\n",
    "    \"            pass\\n\",\n",
    "    \"    return recids\\n\",\n",
    "    \"\\n\",\n",
    "    \"def _load_list_recids(root_dir):\\n\",\n",
    "    \"    aggregate = set()\\n\",\n",
    "    \"    for path in sorted(Path(root_dir).glob('*')):\\n\",\n",
    "    \"        if not path.is_file():\\n\",\n",
    "    \"            continue\\n\",\n",
    "    \"        raw = path.read_text(encoding='utf-8').strip()\\n\",\n",
    "    \"        if not raw:\\n\",\n",
    "    \"            continue\\n\",\n",
    "    \"        try:\\n\",\n",
    "    \"            aggregate |= _extract_recids(json.loads(raw))\\n\",\n",
    "    \"            continue\\n\",\n",
    "    \"        except json.JSONDecodeError:\\n\",\n",
    "    \"            pass\\n\",\n",
    "    \"        for line in raw.splitlines():\\n\",\n",
    "    \"            line = line.strip()\\n\",\n",
    "    \"            if not line:\\n\",\n",
    "    \"                continue\\n\",\n",
    "    \"            try:\\n\",\n",
    "    \"                aggregate |= _extract_recids(json.loads(line))\\n\",\n",
    "    \"                continue\\n\",\n",
    "    \"            except json.JSONDecodeError:\\n\",\n",
    "    \"                pass\\n\",\n",
    "    \"            try:\\n\",\n",
    "    \"                aggregate.add(int(line))\\n\",\n",
    "    \"            except ValueError:\\n\",\n",
    "    \"                continue\\n\",\n",
    "    \"    return aggregate\\n\",\n",
    "    \"\\n\",\n",
    "    \"lists_dir = Path('../lists')\\n\",\n",
    "    \"list_recids = _load_list_recids(lists_dir) if lists_dir.exists() else set()\\n\",\n",
    "    \"master_recids = {int(r) for r in master_cache.keys()}\\n\",\n",
    "    \"missing_recids = sorted(master_recids - list_recids)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"Master cache recids: {len(master_recids)}\\\")\\n\",\n",
    "    \"print(f\\\"Recids found in lists: {len(list_recids)}\\\")\\n\",\n",
    "    \"print(f\\\"Missing recids: {len(missing_recids)}\\\")\\n\",\n",
    "    \"if missing_recids:\\n\",\n",
    "    \"    print(\\\"Sample missing recids:\\\", missing_recids[:10])\"\n",
    "   ],\n",
