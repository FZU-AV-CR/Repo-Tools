    "   \"outputs\": [],\n",
    "   \"execution_count\": null,\n",
    "   \"source\": [\n",
    "    \"# attempt to download file from temp index 773\\n\",\n",
    "    \"# 82852\\n\",\n",
    "    \"# downloads/82852/Y00761.45.al      1      0\\n\",\n",
    "    \"# downloads/82852/Y00792.41.al      1      0\\n\",\n",
    "    \"# print(temp['files'][771]['remote'])\\n\",\n",
    "    \"# download_single_file(\\\"downloads\\\", temp['files'][773]['remote'], \\\"http\\\", \\\"pycurl\\\")\\n\",\n",
    "    \"# download_single_file(\\\"downloads\\\", \\\"root://eospublic.cern.ch//eos/opendata/delphi/simulated-data/cern/gpym6143c1/v99_4/206.7/run20773.xsdst\\\", \\\"xrootd\\\", \\\"xrootd\\\")\"\n",
    "   ],\n",
    "   \"id\": \"50c8c32f259aaa0f\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null,\n",
    "   \"source\": [\n",
    "    \"# print one sample metadata file from delphi\\n\",\n",
    "    \"import json\\n\",\n",
    "    \"with open('../metadata/83701.json', 'r') as f:\\n\",\n",
    "    \"    metadata = json.load(f)\\n\",\n",
    "    \"    print(json.dumps(metadata, indent=2))\"\n",
    "   ],\n",
    "   \"id\": \"a12aefa5b028b625\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null,\n",
    "   \"source\": [\n",
    "    \"# expand master cache using lists/ metadata\\n\",\n",
    "    \"from pathlib import Path\\n\",\n",
    "    \"\\n\",\n",
    "    \"MASTER_CACHE_PATH = Path('delphi_records_master.json')\\n\",\n",
    "    \"\\n\",\n",
    "    \"def _iter_metadata_records(payload):\\n\",\n",
    "    \"    if isinstance(payload, dict):\\n\",\n",
    "    \"        yield payload\\n\",\n",
    "    \"        for key in ('hits', 'records', 'datasets', 'results', 'entries', 'items'):\\n\",\n",
    "    \"            seq = payload.get(key)\\n\",\n",
    "    \"            if isinstance(seq, list):\\n\",\n",
    "    \"                for item in seq:\\n\",\n",
    "    \"                    yield from _iter_metadata_records(item)\\n\",\n",
    "    \"    elif isinstance(payload, list):\\n\",\n",
    "    \"        for item in payload:\\n\",\n",
    "    \"            yield from _iter_metadata_records(item)\\n\",\n",
    "    \"\\n\",\n",
    "    \"def _extract_recid_from_record(record):\\n\",\n",
    "    \"    candidates = [\\n\",\n",
    "    \"        record.get('recid'),\\n\",\n",
    "    \"        record.get('id'),\\n\",\n",
    "    \"        (record.get('metadata') or {}).get('recid'),\\n\",\n",
    "    \"        (record.get('metadata') or {}).get('id'),\\n\",\n",
    "    \"    ]\\n\",\n",
    "    \"    for cand in candidates:\\n\",\n",
    "    \"        if cand is None:\\n\",\n",
    "    \"            continue\\n\",\n",
    "    \"        try:\\n\",\n",
    "    \"            return int(cand)\\n\",\n",
    "    \"        except (TypeError, ValueError):\\n\",\n",
    "    \"            continue\\n\",\n",
    "    \"    return None\\n\",\n",
    "    \"\\n\",\n",
    "    \"def _normalize_file_entry(raw):\\n\",\n",
    "    \"    checksum = raw.get('checksum') or raw.get('checksum_value')\\n\",\n",
    "    \"    checksum_type = raw.get('checksum_type')\\n\",\n",
    "    \"    if isinstance(checksum, str) and ':' in checksum and not checksum_type:\\n\",\n",
    "    \"        checksum_type, checksum = checksum.split(':', 1)\\n\",\n",
    "    \"    remote = raw.get('uri') or raw.get('remote') or raw.get('url') or raw.get('link')\\n\",\n",
    "    \"    size = raw.get('size') or raw.get('bytes') or raw.get('filesize')\\n\",\n",
    "    \"    return {\\n\",\n",
    "    \"        'label': raw.get('name') or raw.get('filename') or raw.get('path'),\\n\",\n",
    "    \"        'remote': remote,\\n\",\n",
    "    \"        'local_path': raw.get('local_path') or raw.get('local'),\\n\",\n",
    "    \"        'size': size,\\n\",\n",
    "    \"        'checksum_type': checksum_type,\\n\",\n",
    "    \"        'checksum': checksum,\\n\",\n",
    "    \"        'downloaded': bool(raw.get('downloaded', False)),\\n\",\n",
    "    \"    }\\n\",\n",
    "    \"\\n\",\n",
    "    \"def _extract_files(record):\\n\",\n",
    "    \"    meta = record.get('metadata') or {}\\n\",\n",
    "    \"    files = meta.get('files') or record.get('files') or []\\n\",\n",
    "    \"    normalized = []\\n\",\n",
    "    \"    for item in files:\\n\",\n",
    "    \"        if isinstance(item, dict):\\n\",\n",
    "    \"            normalized.append(_normalize_file_entry(item))\\n\",\n",
    "    \"    return normalized\\n\",\n",
    "    \"\\n\",\n",
    "    \"records_from_lists = {}\\n\",\n",
    "    \"lists_dir = Path('../lists')\\n\",\n",
    "    \"if lists_dir.exists():\\n\",\n",
    "    \"    for path in sorted(lists_dir.glob('*')):\\n\",\n",
    "    \"        if not path.is_file():\\n\",\n",
    "    \"            continue\\n\",\n",
    "    \"        raw_text = path.read_text(encoding='utf-8').strip()\\n\",\n",
    "    \"        if not raw_text:\\n\",\n",
    "    \"            continue\\n\",\n",
    "    \"        decoded = None\\n\",\n",
    "    \"        try:\\n\",\n",
    "    \"            decoded = json.loads(raw_text)\\n\",\n",
    "    \"        except json.JSONDecodeError:\\n\",\n",
    "    \"            pass\\n\",\n",
    "    \"        if decoded is None:\\n\",\n",
    "    \"            for line in raw_text.splitlines():\\n\",\n",
    "    \"                line = line.strip()\\n\",\n",
    "    \"                if not line:\\n\",\n",
    "    \"                    continue\\n\",\n",
    "    \"                try:\\n\",\n",
    "    \"                    decoded = json.loads(line)\\n\",\n",
    "    \"                except json.JSONDecodeError:\\n\",\n",
    "    \"                    decoded = None\\n\",\n",
    "    \"                if decoded is not None:\\n\",\n",
    "    \"                    for rec in _iter_metadata_records(decoded):\\n\",\n",
    "    \"                        recid = _extract_recid_from_record(rec)\\n\",\n",
    "    \"                        if recid is not None and recid not in records_from_lists:\\n\",\n",
    "    \"                            records_from_lists[recid] = rec\\n\",\n",
    "    \"                    decoded = None\\n\",\n",
    "    \"            continue\\n\",\n",
    "    \"        for rec in _iter_metadata_records(decoded):\\n\",\n",
    "    \"            recid = _extract_recid_from_record(rec)\\n\",\n",
    "    \"            if recid is not None and recid not in records_from_lists:\\n\",\n",
    "    \"                records_from_lists[recid] = rec\\n\",\n",
    "    \"\\n\",\n",
    "    \"existing_recids = {int(r) for r in master_cache.keys()}\\n\",\n",
    "    \"new_recids = sorted(set(records_from_lists.keys()) - existing_recids)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"Parsed records from lists/: {len(records_from_lists)}\\\")\\n\",\n",
    "    \"print(f\\\"Existing master-cache recids: {len(existing_recids)}\\\")\\n\",\n",
    "    \"print(f\\\"New recids available: {len(new_recids)}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"if new_recids:\\n\",\n",
    "    \"    for recid in new_recids:\\n\",\n",
    "    \"        files = _extract_files(records_from_lists[recid])\\n\",\n",
    "    \"        master_cache[str(recid)] = {\\n\",\n",
    "    \"            'recid': recid,\\n\",\n",
    "    \"            'done': False,\\n\",\n",
    "    \"            'checked': False,\\n\",\n",
    "    \"            'files': files,\\n\",\n",
