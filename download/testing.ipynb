    "   \"source\": [\n",
    "    \"from cernopendata_client.walker import get_list_directory\\n\",\n",
    "    \"files = get_list_directory(\\\"/eos/opendata/delphi/\\\", True, 60)\\n\",\n",
    "    \"print(len(files))\"\n",
