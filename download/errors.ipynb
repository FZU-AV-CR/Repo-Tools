    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"# Count unique recids in lists/datasets\\n\",\n",
    "    \"folder = \\\"../lists\\\"\\n\",\n",
    "    \"res = set()\\n\",\n",
    "    \"for filename in os.listdir(folder):\\n\",\n",
    "    \"    if filename.endswith(\\\".json\\\") and filename.startswith('delphi-datasets'):\\n\",\n",
    "    \"        with open(os.path.join(folder, filename), 'r', encoding='utf-8') as f:\\n\",\n",
    "    \"            try:\\n\",\n",
    "    \"                data = json.load(f)\\n\",\n",
    "    \"                recids = set()\\n\",\n",
    "    \"                def extract_recids(obj):\\n\",\n",
    "    \"                    if isinstance(obj, dict):\\n\",\n",
    "    \"                        for key, value in obj.items():\\n\",\n",
    "    \"                            if key in ('recid', 'id'):\\n\",\n",
    "    \"                                try:\\n\",\n",
    "    \"                                    recids.add(int(value))\\n\",\n",
    "    \"                                except (TypeError, ValueError):\\n\",\n",
    "    \"                                    pass\\n\",\n",
    "    \"                            extract_recids(value)\\n\",\n",
    "    \"                    elif isinstance(obj, list):\\n\",\n",
    "    \"                        for item in obj:\\n\",\n",
    "    \"                            extract_recids(item)\\n\",\n",
    "    \"                extract_recids(data)\\n\",\n",
    "    \"                res.update(recids)\\n\",\n",
    "    \"            except json.JSONDecodeError:\\n\",\n",
